# ==============================================================================
# TECH7 ELECTRONICS - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local for local development or set in production host
# DO NOT COMMIT REAL PRODUCTION SECRETS TO VERSION CONTROL
# ==============================================================================

# Node Environment
NODE_ENV=production

# JWT Authentication Secret (Generate a strong 64+ char random string in production)
# Example generation: openssl rand -base64 48
JWT_SECRET=your_strong_random_jwt_secret_here_replace_in_production

# Application Base URL
NEXT_PUBLIC_APP_URL=https://tech7electronics.com

# Database Configuration (Reserved for future external/PostgreSQL database migration)
DATABASE_URL=

# Email System Configuration (Hostinger IMAP & SMTP)
# Server-side only - NEVER expose MAIL_PASSWORD to the client/browser
MAIL_USER=comercial@tech7electronics.com
MAIL_PASSWORD=
MAIL_IMAP_HOST=imap.hostinger.com
MAIL_IMAP_PORT=993
MAIL_IMAP_SECURE=true
MAIL_SMTP_HOST=smtp.hostinger.com
MAIL_SMTP_PORT=465
MAIL_SMTP_SECURE=true
