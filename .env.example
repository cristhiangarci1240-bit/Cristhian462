# ==============================================================================
# TECH7 ELECTRONICS - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local for local development or set in production host
# DO NOT COMMIT REAL PRODUCTION SECRETS TO VERSION CONTROL
# ==============================================================================

# Node Environment
NODE_ENV=production

# JWT Authentication Secret (Generate a strong 64+ char random string in production)
# Example generation: openssl rand -base64 48
JWT_SECRET=your_strong_random_jwt_secret_here_replace_in_production

# Application Base URL
NEXT_PUBLIC_APP_URL=https://tech7.com.br
