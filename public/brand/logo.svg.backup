<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 260 56" fill="none">
  <!-- Monogram T7 Box with Circuit Lines -->
  <g transform="translate(0, 4)">
    <rect x="0" y="0" width="48" height="48" rx="8" fill="#0D131A" stroke="#1E293B" stroke-width="1.5"/>
    <!-- Outer Circuit Line -->
    <path d="M6 14 H42 V42 H6 Z" fill="none" stroke="#00E676" stroke-width="1.5" stroke-dasharray="32 10"/>
    <!-- Letter T and 7 Combination -->
    <path d="M12 16 H36 M24 16 V38 M24 22 L34 38" stroke="#00E676" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
    <circle cx="36" cy="16" r="2.5" fill="#FFFFFF"/>
    <circle cx="12" cy="16" r="2" fill="#00E676"/>
    <circle cx="34" cy="38" r="2" fill="#00E676"/>
  </g>

  <!-- Typography TECH7 -->
  <text x="62" y="32" font-family="'Outfit', 'Inter', -apple-system, sans-serif" font-weight="900" font-size="25" fill="#FFFFFF" letter-spacing="-0.3">TECH<tspan fill="#FFFFFF">7</tspan></text>
  
  <!-- Subtitle ELECTRONICS -->
  <text x="63" y="45" font-family="'Inter', -apple-system, sans-serif" font-weight="600" font-size="9" fill="#94A3B8" letter-spacing="3.8">ELECTRONICS</text>
</svg>
